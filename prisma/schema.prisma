// Integration Platform data model.
//
// Postgres everywhere: local dev, the test suite and deployment all run the
// same provider. Prisma's datasource `provider` must be a literal rather than
// `env()`, and the generated client is provider-specific — a client built for
// `postgresql` refuses a `file:` URL outright — so one schema can only ever
// serve one engine. Keeping that engine the same in every environment is what
// makes this file the whole story rather than a template for two.
//
// Two conventions below are older than that decision:
//   - Status/type columns are `String`, validated in app code against const
//     unions in src/core/types.
//   - JSON columns are `String` holding serialized JSON, read and written
//     through helpers in src/core/repositories/json-column.ts.
// Both exist because the tests used to run on SQLite, which supports neither
// `enum` nor `Json` through Prisma. Postgres supports both, so promoting these
// columns to native enum/jsonb is now possible and worth doing — but it is a
// data migration plus a sweep through the repositories and the type layer, not
// a schema edit, so it is left as a follow-up rather than smuggled into a
// change of provider.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // What the app runs on. In deployment this is a transaction pooler and needs
  // `pgbouncer=true`; against a plain local server it is just the server.
  url = env("DATABASE_URL")

  // An unpooled route, used only by `prisma db push` / `migrate`: those take
  // advisory locks and run DDL, neither of which survives transaction-mode
  // pooling. With no pooler in front, set it to the same value as DATABASE_URL.
  //
  // Not optional, even locally. Prisma resolves `env()` while *parsing* this
  // file, so an unset DIRECT_URL fails `generate`, `validate` and every other
  // CLI command with P1012 before any of them tries to reach a database.
  directUrl = env("DIRECT_URL")
}

model User {
  id    String @id @default(uuid())
  email String @unique

  /// scrypt hash of the login password, formatted `scrypt$<salt>$<key>` by
  /// src/lib/password.ts.
  ///
  /// Nullable, and a null is a refusal rather than a wildcard: a user may exist
  /// before a password is set, and `authorize` rejects any account without one.
  /// The seeded demo user takes its password from DEMO_USER_PASSWORD.
  passwordHash String?

  createdAt    DateTime           @default(now())
  integrations Integration[]
  drafts       IntegrationDraft[]

  customerAccounts CustomerAccount[]
  identityRuns     IdentityResolutionRun[]
}

model Integration {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Registered provider name, e.g. "hubspot" | "salesforce" | "mock".
  providerName String

  /// IntegrationStatus: pending_authorization | active | expired |
  /// requires_reauthorization | error
  status String

  /// User-facing label, e.g. "HubSpot — Acme sandbox".
  instanceLabel String

  /// Hours between scheduled syncs. Clamped to 1..168 in app code.
  syncIntervalHours Int @default(24)

  /// Rank used to settle *value* conflicts between sources — lower wins.
  ///
  /// Never used for matching. Precedence decides what an account says about
  /// itself; it can never repartition which customers belong together, because
  /// if it could, changing a rank would silently regroup someone's customer
  /// list. Clamped to 1..1000 in app code, as syncIntervalHours is clamped.
  ///
  /// Per-integration rather than per-provider, so two HubSpot portals can be
  /// ordered against each other. Defaulting every integration to the same
  /// value means most conflicts start tied — deliberately: a tie is reported
  /// as a `field_conflict` rather than resolved by an arbitrary pick dressed
  /// up as a decision.
  identityPriority Int @default(100)

  authorizationTimestamp DateTime?
  lastSyncTimestamp      DateTime?

  /// Set when token revocation failed during deletion, for admin follow-up.
  pendingTokenRevocation Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  functions        IntegrationFunction[]
  token            OAuthToken?
  fieldMappings    FieldMapping[]
  discoveredFields DiscoveredField[]
  customers        Customer[]
  contacts         Contact[]
  products         Product[]
  offerings        Offering[]
  prices           Price[]
  features         Feature[]
  entitlements     Entitlement[]
  agreements       Agreement[]
  subscriptions    Subscription[]
  agreementItems   AgreementItem[]
  agreementEntitlements AgreementEntitlement[]
  agreementDiscounts    AgreementDiscount[]
  invoices         Invoice[]
  invoiceLines     InvoiceLine[]
  payments         Payment[]
  syncRuns         SyncRun[]

  @@index([userId])
  @@index([status])
}

/// The functions one integration serves.
///
/// An integration is many-to-one with functions, not one-to-one: a single
/// HubSpot connection can supply identity data from companies and contacts
/// *and* support data from tickets. The OAuth scopes requested are the union
/// across these rows, which is why they must be known before authorization.
model IntegrationFunction {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Registered function name, e.g. "identity" | "support".
  functionName String

  addedAt DateTime @default(now())

  @@unique([integrationId, functionName])
  @@index([functionName])
}

model OAuthToken {
  integrationId String      @id
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// AES-256-GCM ciphertext. Never logged, never returned by any API route.
  accessTokenEnc  String
  refreshTokenEnc String?

  expiresAt DateTime

  /// Space-joined scopes this token was actually granted.
  ///
  /// Adding a function to an existing integration widens the scopes it needs,
  /// and the stored token predates that widening. Comparing the union required
  /// now against what was granted is how we detect that re-consent is due,
  /// rather than discovering it as a 403 mid-sync.
  grantedScopes String @default("")

  /// Provider-specific extras captured from the token response, as JSON.
  /// Salesforce stores `instance_url` here — every subsequent Salesforce API
  /// call needs it, so losing it breaks the integration entirely.
  providerMetadata String @default("{}")

  updatedAt DateTime @updatedAt
}

model FieldMapping {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Which function this mapping belongs to. Two functions on one
  /// integration can both write to the same target object, so the function is
  /// part of a mapping's identity.
  functionName String

  /// Target object within that function, e.g. "customer" | "contact".
  /// Target paths are object-qualified so a contact field can never be mapped
  /// onto a customer record.
  targetObject String

  /// Dot-notation path into the provider payload, e.g. "properties.domain".
  sourceFieldPath String

  /// Unqualified field name within targetObject, e.g. "domain" or
  /// "customFields.accountTier".
  targetFieldPath String

  /// FieldTransform: none | trim | lowercase | domainFromUrl | dateOnly
  transform String @default("none")

  createdAt DateTime @default(now())

  @@unique([integrationId, functionName, targetObject, targetFieldPath])
  @@index([integrationId])
  @@index([integrationId, functionName])
}

/// Cache of fields discovered from a provider's schema API, used to populate the
/// source-field dropdown in the mapping editor.
model DiscoveredField {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  functionName String
  targetObject String
  path         String
  label        String
  type         String
  fetchedAt    DateTime @default(now())

  @@unique([integrationId, functionName, targetObject, path])
  @@index([integrationId, functionName, targetObject])
}

model Customer {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Provider-assigned id. The upsert key, paired with integrationId.
  externalSourceId String

  name   String
  domain String?

  /// Account-level email. A real column rather than a `customFields` key
  /// because identity resolution matches on it, and customFields is serialized
  /// JSON — neither queryable nor indexable. Only Stripe and Metrifox supply
  /// one; both CRMs carry no account-level address, so null is common.
  email String?

  industry   String?
  createDate DateTime?

  /// CustomerType: prospect | customer | partner | vendor
  type String?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  customFields String @default("{}")

  /// JSON object of `<providerName> -> <that provider's id for this company>`,
  /// written from `crossRef.<provider>` mapping rules.
  ///
  /// Kept beside `customFields` rather than written straight to
  /// `CustomerAccountKey`, because at sync time this row has no account yet —
  /// resolution is a separate per-user pass, and the whole point of a
  /// cross-reference is that the record it names may not have been synced.
  /// Bounded by construction: a target path must name a registered provider and
  /// mapping targets are unique, so there is one key per provider at most.
  crossRefs String @default("{}")

  /// The same shape as `crossRefs`, but supplied by a human rather than by a
  /// mapping rule — pasted or uploaded `<local id>,<foreign id>` pairs, which
  /// is the honest answer for Metrifox's `payments_stripe_customers` table
  /// since no API exposes it.
  ///
  /// A separate column rather than merged into `crossRefs`, for a reason that
  /// is not stylistic: the record writer overwrites `crossRefs` wholesale on
  /// every upsert, so an imported pair stored there would survive exactly until
  /// the next sync. Keeping them apart also lets a key record
  /// `imported_crosswalk` as its source rather than claiming a mapping rule it
  /// never came from.
  importedCrossRefs String @default("{}")

  /// The canonical company this row resolves to.
  ///
  /// Nullable only in the window before the first resolution pass sees the row.
  /// The pass's own "done when" is that every customer ends up linked — a
  /// record with no usable match key gets a singleton account rather than being
  /// left out, so a lasting null means resolution has not run, not that the
  /// record was unmatchable.
  ///
  /// `SetNull` rather than `Cascade`: accounts are created, absorbed and reaped
  /// by every pass, and a cascade would make deleting an emptied shell delete
  /// the customers that had just been moved off it.
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  updatedAt  DateTime    @updatedAt
  contacts   Contact[]
  agreements Agreement[]

  /// Billing rows this customer is the subject of. Nullable on the billing
  /// side because `billing` is a different function that may not be connected,
  /// which is exactly the situation `Agreement.customerId` documents.
  invoices   Invoice[]
  payments   Payment[]

  /// Both sides of every human assertion naming this row. Two relations
  /// because the pair is canonically ordered by id, so a given customer may be
  /// on either side depending on who it is paired with.
  assertionsAsLeft  IdentityAssertion[] @relation("AssertionLeft")
  assertionsAsRight IdentityAssertion[] @relation("AssertionRight")

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  @@index([customerAccountId])
}

model Contact {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  externalSourceId String

  name     String
  email    String?
  jobTitle String?
  phone    String?

  /// Resolved internal customer. Null when the provider gave us a company id we
  /// could not resolve — the contact is kept and a warning is recorded.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// The provider's own company id, before resolution. Kept so a later sync can
  /// resolve an association that failed the first time.
  externalCustomerId String?

  customFields String @default("{}")

  updatedAt DateTime @updatedAt

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Catalog
//
// What a company sells, as the `catalog` function syncs it. Scoped by
// `Integration` like `Customer` and `Contact`, and for the same reason: these
// are one connection's view of a catalog, keyed by that provider's own ids.
//
// Note what is *not* here. There is no link to a customer, an account, or an
// agreement. A product exists whether or not anyone has ever bought it, which
// is why the catalog is its own function rather than a wing of identity — the
// two share no record and no ordering constraint, and either can be connected
// without the other.
// ---------------------------------------------------------------------------

/// A thing the company sells. One per provider product record.
model Product {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Provider-assigned id. The upsert key, paired with integrationId.
  externalSourceId String

  name        String
  description String?

  /// Whether the provider still offers this.
  ///
  /// Nullable, and the null is meaningful: it says the provider told us
  /// nothing, which is different from `false`. Stripe archives rather than
  /// deletes and keeps returning archived products from `/v1/products`, so
  /// without this column a catalog silently accumulates things nobody can buy,
  /// indistinguishable from things they can.
  active Boolean?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  customFields String @default("{}")

  updatedAt DateTime   @updatedAt
  offerings Offering[]

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
}

/// A purchasable item or plan configuration within a Product.
model Offering {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  externalSourceId String

  name        String
  description String?

  /// Resolved internal product. Null when the provider gave us a product id we
  /// could not resolve.
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  externalProductId String?

  active Boolean?

  customFields String @default("{}")

  updatedAt      DateTime        @updatedAt
  prices         Price[]
  entitlements   Entitlement[]
  agreements     Agreement[]
  agreementItems AgreementItem[]
  invoiceLines   InvoiceLine[]

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  @@index([productId])
}

/// A specific price point, currency, and billing interval for an Offering.
model Price {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  externalSourceId String

  name String

  /// Resolved internal offering. Null when the provider gave us an offering id we
  /// could not resolve.
  offeringId         String?
  offering           Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  externalOfferingId String?

  /// Amount in the currency's minor unit — cents, pence, yen.
  amountMinor Int?

  /// ISO 4217, as the provider cased it.
  currency String?

  /// BILLING_MODELS: how this price is charged. Stripe's
  /// `billing_scheme`/`recurring.usage_type`, Chargebee's `pricing_model`,
  /// Stigg's `billingModel`. Null when the provider did not say.
  billingModel String?

  /// Units per block for a block-priced charge — Stigg's `blockSize`. Null for
  /// every other provider and for an unblocked price.
  blockSize Int?

  /// BillingInterval: day | week | month | year | one_time.
  interval      String?
  intervalCount Int?

  active Boolean?

  customFields String @default("{}")

  updatedAt      DateTime        @updatedAt
  agreementItems AgreementItem[]
  invoiceLines   InvoiceLine[]

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  @@index([offeringId])
}

// ---------------------------------------------------------------------------
// Feature and entitlement
//
// The two things an entitlement attachment was doing on one row, split apart.
//
// `Feature` is the reusable *definition* — Chargebee's `Feature`, Stripe's
// `EntitlementFeature` (`feat_…`), Stigg's `Feature`. `Entitlement` is the
// *link*: this offering includes that feature, at this limit — Stripe's
// `ProductFeature` (`prodft_…`), Chargebee's `item_entitlement`. Stripe names
// the pair the other way round, which is why each handler states which of its
// objects is which.
//
// The split is what lets one shared feature carry its own name, lookup key and
// metered flag once, rather than denormalized onto every offering that includes
// it.
// ---------------------------------------------------------------------------

/// The reusable definition of a capability.
model Feature {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// The provider's definition id — Stripe's `feat_…`, Chargebee's feature id.
  /// The upsert key, paired with integrationId.
  externalSourceId String

  /// The feature's display name. Required.
  name String

  /// The stable machine key an application gates on — "premium-support".
  lookupKey String?

  /// Whether the feature is consumed by measured usage rather than granted as a
  /// fixed flag — Chargebee's `metered`.
  ///
  /// Nullable, for `Product.active`'s reason. Stripe's Entitlements API models a
  /// feature as a bare flag with no quantity and no metered concept — metered
  /// there is a property of a price — so for Stripe the honest answer is "we
  /// were not told", and `false` would be a claim the provider never made.
  isMetered Boolean?

  /// What a metered grant counts — "dashboard", "seats". Chargebee's `unit`.
  unit String?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  customFields String @default("{}")

  updatedAt DateTime @updatedAt

  entitlements Entitlement[]
  agreementEntitlements AgreementEntitlement[]

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  /// "Which offerings include `premium-support`?" — the query the table is for.
  @@index([integrationId, lookupKey])
}

/// The offering × feature join: "this offering includes that feature, at this
/// limit." Stripe's `ProductFeature` (`prodft_…`), Chargebee's
/// `item_entitlement`.
model Entitlement {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Stripe's `prodft_…`, Chargebee's item entitlement id. The upsert key.
  externalSourceId String

  /// Resolved internal feature. SetNull with the provider's own id kept beside
  /// it, for the reason `Offering.productId` gives: definitions and attachments
  /// can be read in either order across runs, and the row is still readable
  /// without the link.
  featureId         String?
  feature           Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  externalFeatureId String?

  /// Resolved internal offering, on the same terms.
  offeringId         String?
  offering           Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  externalOfferingId String?

  /// The provider's answer verbatim — Chargebee's "50", "true".
  value String?

  /// Chargebee's entitlement *level* label — "Maximum", "Available".
  valueName String?

  /// The numeric form of `value`, null when there is no number. Null means "no
  /// stated limit", which is also how unlimited arrives; `value` is what tells
  /// a reader which of the two it was. Always null on Stripe, which states no
  /// limit on an attachment.
  limitValue Int?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  customFields String @default("{}")

  updatedAt DateTime @updatedAt

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  @@index([offeringId])
  @@index([featureId])
}

// ---------------------------------------------------------------------------
// Agreement
//
// What the customer agreed to. The shared node holds what every kind of
// agreement has — who, what, which type, where it stands, from when — and each
// type's own detail hangs off it in its own table.
//
// The alternative was one wide table with a column per type's needs. It was
// rejected for a reason that shows up in the constraints rather than in taste:
// on a shared table no type-specific column can ever be NOT NULL, because every
// column has to tolerate the types that do not have it. `Subscription` can
// require a period; an `Agreement` with a `currentPeriodEnd` column never
// could, because a signed contract has no period. Adding the fourth type is
// then a new table rather than an ALTER against every row already stored.
//
// `agreementType` stays on the parent regardless: it is what tells a reader
// which detail table to join without probing all of them.
// ---------------------------------------------------------------------------

/// The shared commercial node. One row per subscription, order form or contract.
model Agreement {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Provider-assigned id. The upsert key, paired with integrationId.
  externalSourceId String

  /// Required, and frequently synthesized — Stripe gives a subscription no name.
  name String

  /// AgreementType: subscription | order_form | contract | deal.
  /// Not nullable: a row that cannot say what kind of agreement it is cannot be
  /// joined to its detail table, which is the whole point of the column.
  agreementType String

  /// AgreementStatus: draft | trialing | active | past_due | paused | canceled | expired.
  /// Nullable, because a provider that reports no status has told us nothing,
  /// and guessing `active` would be inventing the one fact worth syncing.
  status String?

  /// Resolved internal customer. Null when the provider named one we could not
  /// resolve — most often because `identity` is not on this integration.
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// The provider's own customer id, kept so a later sync can link it.
  externalCustomerId String?

  /// Resolved internal offering, and the provider's own price id beside it.
  /// Same shape and same reason: `catalog` may not be on this integration yet.
  ///
  /// The offering of whichever line the handler nominated — position 0 for
  /// Stripe. It is a convenience, not the whole truth: `items` holds every
  /// priced line, and a handler that declines to nominate one leaves this null
  /// rather than picking arbitrarily. On a twelve-line contract no line is
  /// primary, and this column should be empty there.
  offeringId         String?
  offering           Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  externalOfferingId String?

  /// When the agreement began, as against when we first saw it.
  effectiveDate DateTime?
  endDate       DateTime?

  /// ISO 4217, as the provider cased it.
  currency String?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  customFields String @default("{}")

  /// Provider-specific facts that have no column of their own, as JSON.
  ///
  /// Same name as `OAuthToken.providerMetadata`, deliberately a different
  /// thing: there it is extras from the token response (Salesforce's
  /// `instance_url`) that every later API call needs; here it is the raw
  /// provider bag on an agreement — Chargebee's `meta_data`, Stripe's
  /// `metadata`. Both are "the provider's own key/values we did not model",
  /// which is why the name is shared, but nothing reads across the two.
  ///
  /// Per decision 9 this column is on the agreement function's five tables
  /// only; identity and catalog keep using `customFields`. Serialized JSON via
  /// src/core/repositories/json-column.ts, bounded by MAX_CUSTOM_FIELDS.
  providerMetadata String @default("{}")

  updatedAt DateTime @updatedAt

  subscription Subscription?
  items        AgreementItem[]
  entitlements AgreementEntitlement[]
  discounts    AgreementDiscount[]

  /// Invoices raised under this agreement. Nullable and SetNull on the
  /// invoice's side, for the reason this relation is declared at all: `billing`
  /// and `agreement` are separate functions that may not both be connected.
  invoices     Invoice[]

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  @@index([customerId])
  @@index([offeringId])
  /// "Every subscription on this integration" without scanning the others.
  @@index([integrationId, agreementType])
}

/// Recurring-billing detail for an Agreement of type "subscription".
model Subscription {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Provider-assigned id — the same id its Agreement carries, in its own table.
  externalSourceId String

  /// The agreement this details.
  ///
  /// Required, @unique and Cascade, where every other association FK in this
  /// schema is nullable and SetNull. All three say the same thing: this extends
  /// exactly one agreement and is not salvageable without it. An offering
  /// without its product is still a readable price; a period without its
  /// agreement is a pair of dates about nothing.
  ///
  /// Consequently there is no `externalAgreementId` and no relink pass. Both
  /// rows come off one source record in one run, so "arrived before its parent"
  /// — the case the other two children keep an external id for — cannot happen.
  agreementId String    @unique
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialStartsAt      DateTime?
  trialEndsAt        DateTime?

  /// When cancellation was requested, which can precede the period end by a
  /// month. Distinct from `Agreement.endDate`, which is when it actually stops.
  canceledAt        DateTime?
  cancelAtPeriodEnd Boolean?

  /// The moment the provider says the subscription stops — Chargebee's
  /// `cancel_at`. Distinct from `canceledAt`, which is when cancellation was
  /// requested, and from `Agreement.endDate`, which is the shared node's view.
  cancelAt DateTime?

  /// The next renewal the provider has scheduled. The date that answers "what
  /// renews next", which is why the read model sorts on it and falls back to
  /// `currentPeriodEnd`.
  nextBillingAt DateTime?

  /// The cadence of the subscription's *primary* line — Chargebee's
  /// `billing_period_unit`, Stripe's primary price `recurring.interval`.
  /// SUBSCRIPTION_BILLING_PERIODS: day | week | month | year.
  ///
  /// States the primary line's cadence and only that: a subscription whose
  /// lines carry different intervals does not have one cadence, and the
  /// handler leaves this null there rather than picking. Null is also the
  /// honest answer for a provider that did not say.
  billingPeriod String?

  /// How many `billingPeriod`s make up one cycle — every 3 months is
  /// `billingPeriod: "month"`, `billingPeriodCount: 3`.
  billingPeriodCount Int?

  /// CollectionMethod: automatic | manual | none. Validated in app code
  /// against the union rather than free text.
  ///
  /// Rows written before this vocabulary arrived hold the provider's raw word
  /// (`charge_automatically`); they are corrected by the next sync, which
  /// overwrites them, and are wrong until then.
  collectionMethod String?
  quantity         Int?

  /// How many priced lines the subscription carries, as the provider reported
  /// it. Kept after `AgreementItem` arrived rather than dropped as redundant:
  /// this is the provider's count and `agreement.items` is ours, and the two
  /// disagreeing is the signal that a line failed to write.
  itemCount Int?

  customFields String @default("{}")

  /// Provider-specific facts with no column of their own, as JSON. See
  /// `Agreement.providerMetadata` for why the name matches `OAuthToken`'s and
  /// how it is the raw bag, not token extras. Serialized via
  /// src/core/repositories/json-column.ts, bounded by MAX_CUSTOM_FIELDS;
  /// values over the bound are dropped silently, so this is a place to look
  /// when a provider fact is missing rather than a guarantee it is kept.
  providerMetadata String @default("{}")

  updatedAt DateTime @updatedAt

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  /// Renewal and churn questions are date-ranged over one integration, and the
  /// read model orders on `nextBillingAt` falling back to `currentPeriodEnd`.
  /// `cancelAt` joins the rationale because "what cancels next" is the same
  /// query one lifecycle stage later; no separate index for two nullable dates
  /// until a sort actually leads with one.
  @@index([integrationId, currentPeriodEnd])
}

/// One priced line on an agreement — the base plan, a seat count, an add-on.
///
/// The row is the *selection*, not the thing selected: what it bills for is the
/// Offering it points at, which already holds the money. Nothing here is
/// computed and there is deliberately no amount column — a subscription's true
/// total is the provider's to state, not ours to sum.
///
/// Hung off `Agreement` rather than `Subscription`, and that is the whole
/// design. Line items are not a subscription quirk: Salesforce has
/// `ContractLineItem`, `OrderItem` and `QuoteLineItem`, HubSpot models what a
/// deal sold as line items, and an order form is essentially a header plus its
/// lines. A subscription is the odd case, the one where a single offering link
/// almost suffices — which is why this table was missing for so long.
///
/// **This is the only synced table whose rows are deleted.** The writer
/// reconciles an agreement's lines against what the handler just yielded, so a
/// removed add-on does not linger. See `writeAgreementItems` for the two
/// guards that make that safe, and `SyncHandler` for the completeness
/// obligation they rest on.
model AgreementItem {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Provider-assigned id — Stripe's `si_…`. The upsert key, and what
  /// reconciliation compares against.
  externalSourceId String

  /// Required and Cascade, for `Subscription`'s reason one level down: this
  /// line extends exactly one agreement and is not salvageable without it.
  /// Consequently there is no `externalAgreementId` and no relink pass on this
  /// edge — both rows come off one source record in one run, so "arrived
  /// before its parent" cannot happen.
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  /// The price this line is billed at — Stripe's `price_…` on the item. The
  /// precise link: an offering can have several prices (monthly, yearly), and
  /// only this says which one was sold. Nullable and SetNull with the
  /// provider's own id retained beside it, for `Agreement.offeringId`'s
  /// reason: `catalog` may not be on this integration yet.
  priceId         String?
  price           Price?  @relation(fields: [priceId], references: [id], onDelete: SetNull)
  externalPriceId String?

  /// What this line bills for — the offering the price belongs to (Stripe's
  /// `price.product`). Stored beside `priceId` rather than read through it so
  /// the line still names what was sold when the price itself did not resolve,
  /// and so offering-level queries need no second join. Both come off the same
  /// item in the same run, so they agree unless one of them failed to resolve.
  offeringId         String?
  offering           Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  externalOfferingId String?

  quantity Int?

  /// The provider's own ordering of its lines, nothing more. It is *not* a
  /// rank and position 0 is not "the important one" — on a twelve-line
  /// contract no line is primary. It happens to be the line
  /// `Agreement.offeringId` points at, because that is how the Stripe handler
  /// picks one; a provider whose handler picks none leaves that column null
  /// and this one still orders the lines correctly.
  position Int?

  /// AgreementItemType: plan | add_on | usage. Null means the provider did not
  /// say, never "plan".
  ///
  /// Stripe's items are undifferentiated — the first one is the base plan by
  /// convention only — so it writes `usage` for a metered price and nothing
  /// otherwise. Chargebee and Stigg both type their items first-class, and
  /// this column is here so that adding one of them is a handler rather than
  /// an ALTER against rows that cannot say what they are.
  ///
  /// The three members are subscription-shaped, and deliberately so: they are
  /// the vocabulary of the only provider with a handler. A contract line is
  /// none of the three and will leave this null until an order-form provider
  /// arrives with a word of its own.
  itemType String?

  /// How the provider says this line is priced — BILLING_MODELS: flat_fee |
  /// per_unit | tiered | usage_based | one_time. Null when the provider did
  /// not say; Stripe's `price.billing_scheme`/`recurring.usage_type` and
  /// Chargebee's `pricing_model` are the sources.
  ///
  /// Null for Chargebee today: it states metering on the *item price*, which
  /// the subscription list payload does not inline, so the handler declines
  /// rather than guess. The catalog function does resolve it, onto
  /// `Price.billingModel`; faking it here would put a wrong value behind a
  /// right column.
  billingModel String?

  /// What the provider says this line bills per unit for *this subscription*,
  /// in the currency's minor unit — Chargebee's always-present `unit_price`,
  /// even when nothing was overridden.
  ///
  /// Named for what it is rather than `unitPriceOverride`: an "override" column
  /// would be populated on every Chargebee line whether or not anything was
  /// overridden, so the name would assert a comparison the column cannot make.
  /// Null for Stripe, which states no per-unit price on a subscription item.
  unitPriceMinor Int?

  /// Units included at no charge — Chargebee's `free_quantity`.
  freeQuantity Int?

  /// How many billing cycles this line runs for; null means it recurs without
  /// a stated end — Chargebee's `billing_cycles`.
  billingCycles Int?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  customFields String @default("{}")

  /// Provider-specific facts with no column of their own, as JSON. See
  /// `Agreement.providerMetadata`; serialized via
  /// src/core/repositories/json-column.ts, bounded by MAX_CUSTOM_FIELDS, with
  /// over-long values dropped silently.
  providerMetadata String @default("{}")

  updatedAt DateTime @updatedAt

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  /// Both the join and the reconciliation predicate.
  @@index([agreementId])
  @@index([offeringId])
  @@index([priceId])
}

/// The *effective* entitlement a customer holds under one agreement — what this
/// subscriber actually gets, not what the plan offers.
///
/// Distinct from `Entitlement`, deliberately and confusingly so. `Entitlement`
/// is the catalog baseline: "the Pro offering includes 50 seats." This is the
/// per-agreement answer Chargebee's `subscription_entitlements` gives:
/// inherited values and per-subscription overrides folded into one list, which
/// is why `isOverride` is here — it is the only place the difference is
/// visible. The two overlap by construction, so an aggregate that adds this
/// table to `Entitlement` double-counts; a reader picks one.
///
/// Stigg's customer-level promotional grants are a different fact again and are
/// out of scope, so there is no `startsAt`/`expiresAt` window and no
/// `externalEntityId`: the effective list already folds entity-level overrides
/// in, and pre-modelling a window with no handler behind it would repeat the
/// mistake of modelling amendments before anything reads them.
///
/// Rows are only deleted when the provider declares its list complete (see
/// `SyncHandler`); until then the table is upsert-only, so a vanished grant
/// lingers rather than the destructive direction being taken on a guess.
model AgreementEntitlement {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Provider-assigned id where there is one. Chargebee's payload carries none,
  /// so the handler synthesizes `<subscriptionId>:<featureId>`. The upsert key,
  /// and what reconciliation compares.
  externalSourceId String

  /// Required and Cascade, on `Subscription`'s exact reasoning: both rows come
  /// off one source record in one run, so "arrived before its parent" — the
  /// case that keeps an `externalAgreementId` on the other children — cannot
  /// happen, and a row without its agreement is about nothing.
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  /// Nullable because `feature` is a different function that may not be
  /// connected, with the provider's own id kept beside it — `Offering.productId`'s
  /// rule. Unlike the agreement edge this *does* need a relink pass:
  /// `catalog` can arrive in a later run.
  featureId         String?
  feature           Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  externalFeatureId String?

  /// The provider's answer verbatim — Chargebee's "50", "true". Mirrors
  /// `Entitlement` so the two levels read alike.
  value String?

  /// The entitlement's *level* label — "Maximum", "Available".
  valueName String?

  /// The numeric form of `value`, null when there is no number. Null means "no
  /// stated limit", which is also how unlimited arrives; `value` tells a reader
  /// which of the two it was. Always null on Stripe, which states no limit.
  limitValue Int?

  /// Whether this value overrides the catalog baseline rather than inheriting
  /// it — Chargebee's `is_overridden`. Null means the provider did not say.
  isOverride Boolean?

  /// Whether the feature is granted at all — Chargebee's `is_enabled`. Shown on
  /// `/agreements` so a feature the customer does *not* have is not read as a
  /// limit of zero.
  isEnabled Boolean?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  ///
  /// Present even though this table's rows are written by a reconciling writer,
  /// for a reason that is not symmetry: `resolveTargetField` accepts a
  /// `customFields.*` rule for *every* object, so a table whose writer dropped
  /// the bag would let a user map one, save it cleanly, and watch it do nothing
  /// on every sync. The writer persists it for the same reason the others do.
  customFields String @default("{}")

  /// Provider-specific facts with no column of their own, as JSON.
  providerMetadata String @default("{}")

  updatedAt DateTime @updatedAt

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  @@index([agreementId])
  @@index([featureId])
}

/// A discount attached to one agreement, as the provider *stated* it.
///
/// Stated values only, deliberately: there is no computed net, no post-discount
/// total and no amount column on the agreement to reconcile one against. A
/// discount is an assertion the provider made about a price, and the moment we
/// start computing what it comes to we own an arithmetic the provider never
/// agreed to. A subscription's true total is the provider's to state.
///
/// Allowed to carry an amount (`amountOffMinor`) even though `AgreementItem`
/// refuses money: a line is a *selection*, whose money lives on the Offering;
/// a discount's value *is* its amount, so there is nothing to defer to.
///
/// Same parent rule and same delete caveat as `AgreementEntitlement`.
model AgreementDiscount {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// The provider's discount/attachment id — what reconciliation compares.
  externalSourceId String

  /// Required and Cascade, for `AgreementEntitlement`'s reason.
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  /// The coupon the discount came from, when the provider names one. Kept
  /// beside the attachment id because a coupon can be applied to many
  /// agreements; no relation, because there is no coupon table to point at.
  externalCouponId String?

  label String?

  /// DiscountKind: percentage | fixed_amount | free_items. Our vocabulary, not
  /// the provider's — Chargebee's own `type` (with `offer_quantity` for the
  /// third) is translated by the handler.
  kind String?

  /// The stated percentage off, in whole percent.
  percentOff Int?

  /// The stated amount off, in the currency's minor unit.
  amountOffMinor Int?

  /// DiscountStatus: active | expired | removed | scheduled.
  status String?

  startsAt DateTime?
  endsAt   DateTime?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  /// See `AgreementEntitlement.customFields` for why the reconciling writers
  /// carry it: a `customFields.*` rule validates for every object.
  customFields String @default("{}")

  providerMetadata String @default("{}")

  updatedAt DateTime @updatedAt

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  @@index([agreementId])
}

// ---------------------------------------------------------------------------
// Billing
//
// What the customer was billed and what actually moved. Three objects, and the
// split between them is the design:
//
//   `Invoice`      the document — a number, a status, a stated total, when it
//                  was issued and when it was paid.
//   `InvoiceLine`  what the document is made of. A child of the invoice with a
//                  required cascade FK, the same shape `AgreementItem` has and
//                  for the same reason: both rows come off one source record in
//                  one run, so "arrived before its parent" cannot happen.
//   `Payment`      a money movement — a charge or a refund, `kind` saying which.
//                  The settled movement, not the authorization attempt behind
//                  it, so Stripe's PaymentIntent and Chargebee's `authorization`
//                  transactions are deliberately not written.
//
// Two absences are deliberate and load-bearing.
//
// `charge` is **not** an object here, although an earlier declaration of the
// billing function named one. The word carries three incompatible meanings — a
// line on an invoice, Chargebee's one-off item type, Stripe's own `Charge`
// object — and as a placeholder it would mislead more than it documented. What
// it meant ("the billed amount on the invoice") is precisely `InvoiceLine`.
//
// Invoice *totals* are **stated by the provider, never computed**. Both APIs
// define `amount_due` as `total − paid − credits − credit notes`, and credit
// notes are out of scope here, so reproducing that arithmetic would put a
// confidently wrong number on the row the moment one moved. `totalMinor`,
// `amountDueMinor` and `amountPaidMinor` therefore go in verbatim; nothing is
// ever summed from `Payment`, and a reader must not "fix" the redundancy by
// summing lines.
//
// Money is in the currency's **minor unit** on both providers — Chargebee's
// docs say "in cents" on every amount, Stripe's say "smallest currency unit" —
// so there is no conversion anywhere and `parseInteger` refuses a decimal
// rather than truncating it.
// ---------------------------------------------------------------------------

/// One invoice document: what the customer was billed.
model Invoice {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Provider-assigned id. The upsert key, paired with integrationId.
  externalSourceId String

  /// The human invoice number. Stripe's `number`, null while the invoice is a
  /// draft. Chargebee has no separate field — its `id` *is* the sequential
  /// invoice number — so the Chargebee handler maps `id` here in addition to
  /// `externalSourceId`.
  number String?

  /// INVOICE_STATUSES: draft | open | paid | past_due | void | uncollectible.
  /// Nullable, because a provider that reports no status has told us nothing.
  status String?

  /// Resolved internal customer. Nullable with the provider id retained, for
  /// `Agreement.customerId`'s reason: `identity` is a separate function that
  /// may not be connected, and a later relink repairs it.
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  externalCustomerId String?

  /// Resolved internal agreement. Nullable on the same terms: `agreement` is a
  /// different function. A Chargebee invoice whose lines span several
  /// subscriptions leaves this null on purpose — see the handler — rather than
  /// linking the whole invoice to one of them.
  agreementId         String?
  agreement           Agreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  externalAgreementId String?

  /// ISO 4217, as the provider cased it.
  currency String?

  /// Stated amounts in the currency's minor unit. `subtotalMinor` is the sum of
  /// the lines; `discountMinor` and `taxMinor` are stated scalars only — both
  /// stay null on Stripe, whose discounts and taxes are arrays of per-source
  /// amounts, and `discountMinor` stays null on Chargebee, which states none.
  /// **Every null means "the provider did not state it", never zero.**
  subtotalMinor  Int?
  discountMinor  Int?
  taxMinor       Int?
  /// Stated by the provider, never computed. See the section comment above.
  totalMinor     Int?
  amountDueMinor Int?
  /// Stated by the provider, never computed, and never summed from `Payment`:
  /// that table is deliberately incomplete (dropped authorizations), so a sum
  /// would be wrong in exactly the cases this number is right.
  amountPaidMinor Int?

  /// When the document was issued. Stripe's
  /// `status_transitions.finalized_at` (null while a draft), Chargebee's
  /// `generated_at` (absent until a pending invoice closes). Null on a draft.
  issuedAt DateTime?
  /// Stripe's `due_date` (null when collection is automatic), Chargebee's
  /// `due_date`.
  dueAt    DateTime?
  /// Stripe's `period_start`/`period_end` — the window invoice items may be
  /// attached to. Chargebee has no equivalent, so both are null there.
  periodStart DateTime?
  periodEnd   DateTime?
  /// Stripe's `status_transitions.paid_at`, Chargebee's `paid_at`.
  paidAt      DateTime?

  /// Stripe's `hosted_invoice_url`. Chargebee has none. The one place a link
  /// belongs on its own row.
  hostedUrl String?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  customFields String @default("{}")

  /// Provider-specific facts with no column of their own, as JSON. Serialized
  /// via src/core/repositories/json-column.ts. Chargebee writes
  /// `subscription_id: "consolidated"` here when an invoice's lines span several
  /// subscriptions, which is the honest record of why `agreementId` is null.
  providerMetadata String @default("{}")

  updatedAt DateTime @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  @@index([customerId])
  @@index([agreementId])
  /// "Open invoices on this integration" without scanning the others.
  @@index([integrationId, status])
}

/// One line on an invoice — the billed figure itself.
///
/// **This is the one deliberate departure from the no-amount rule** on
/// `AgreementItem`. An agreement line is a *selection*, and its amount would be
/// a second copy of the offering's price; an invoice line *is* the money, so
/// `unitAmountMinor` and `amountMinor` belong here. Neither is ever summed into
/// `Invoice.totalMinor`, which the provider states.
model InvoiceLine {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Provider-assigned id. The upsert key, and what reconciliation compares.
  externalSourceId String

  /// Required and Cascade, for `Subscription`'s and `AgreementItem`'s reason:
  /// this line extends exactly one invoice and is not salvageable without it.
  /// Consequently there is no `externalInvoiceId` and no relink pass on this
  /// edge — both rows come off one source record in one run.
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String?
  quantity    Int?

  /// The money, in the currency's minor unit. Stripe's per-unit figure arrives
  /// as `pricing.unit_amount_decimal`, a decimal *string* that is legitimately
  /// fractional for tiered or usage prices, so it can fail `parseInteger` and
  /// leave `unitAmountMinor` null; `amountMinor` (the line total) is always an
  /// integer smallest-unit value and is the reliable one.
  unitAmountMinor Int?
  amountMinor     Int?

  /// The service window — Stripe's line `period`, Chargebee's
  /// `date_from`/`date_to`. What makes an invoice answer "what was delivered in
  /// March".
  periodStart DateTime?
  periodEnd   DateTime?

  /// Stripe's `parent.invoice_item_details.proration`. Chargebee has no
  /// spelling, so null there.
  isProration Boolean?

  /// INVOICE_LINE_TYPES — a vocabulary of its own, not `AGREEMENT_ITEM_TYPES`:
  /// an invoice line answers "what kind of line is this on the bill?", which
  /// includes `discount`, `credit` and `adjustment`.
  itemType String?

  /// The price this line was billed at, and the offering it belongs to.
  /// Nullable and SetNull with the provider's own id retained beside each, for
  /// `AgreementItem.priceId`'s reason: `catalog` may not be on this integration.
  priceId         String?
  price           Price?  @relation(fields: [priceId], references: [id], onDelete: SetNull)
  externalPriceId String?
  offeringId         String?
  offering           Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  externalOfferingId String?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  customFields String @default("{}")

  /// Provider-specific facts with no column of their own, as JSON. Serialized
  /// via src/core/repositories/json-column.ts.
  providerMetadata String @default("{}")

  updatedAt DateTime @updatedAt

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  /// Both the join and the reconciliation predicate.
  @@index([invoiceId])
  @@index([offeringId])
  @@index([priceId])
}

/// A money movement — a settled charge or a refund.
///
/// The grain is the *movement*, not the allocation: Stripe's `Charge` or
/// `Refund` (which carries `method`, `disputed` and `failure_code`), Chargebee's
/// `payment`/`refund`/`payment_reversal` transaction. Stripe's `InvoicePayment`
/// allocation object is read only as an index into the invoice link, because
/// taking it as the row would darken every method and dispute field.
///
/// An authorization moves no money and is not written at all, so this table's
/// counts will not match a provider's transaction count — correct and intended.
model Payment {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Provider-assigned id. The upsert key, paired with integrationId.
  externalSourceId String

  /// Resolved internal invoice. **Nullable**, unlike `InvoiceLine.invoiceId`:
  /// a Chargebee `linked_invoices` entry exists only for a payment (a refund
  /// has none), a Stripe refund carries no invoice, and a charge raised outside
  /// an invoice has none either. Needs a relink pass.
  invoiceId         String?
  invoice           Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  externalInvoiceId String?

  /// Resolved internal customer, nullable on the same terms.
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  externalCustomerId String?

  /// PAYMENT_KINDS: payment | refund. **Not nullable.** Every row is a movement
  /// and the direction is the first thing a reader needs; there is no third
  /// possibility and the provider never leaves it blank.
  kind String

  /// PAYMENT_STATUSES. Nullable, because a provider may report a status this
  /// union does not recognise, and an unsettled movement reports nothing usable
  /// yet.
  status String?

  amountMinor Int?
  currency    String?

  /// Stripe charge `created`, Chargebee `settled_at`. Named `processedAt`
  /// rather than `paidAt` because a refund is not a payment and one column
  /// naming both would be wrong for one of them.
  processedAt DateTime?

  /// Stripe `payment_method_details.type`, Chargebee `payment_method`. Free
  /// text, deliberately not an enum: Stripe ships ~90 live values and adds more.
  method String?

  /// Stripe charge `failure_code`/`failure_message`, Chargebee
  /// `error_code`/`error_text`. Bounded; the full text goes to
  /// `providerMetadata`.
  failureReason String?

  /// Stripe charge `disputed`, Chargebee `payment_method: "chargeback"`.
  isDisputed Boolean?

  /// The provider's own id where one exists — Stripe's `balance_transaction`,
  /// Chargebee's `id_at_gateway` — kept beside ours for the same reason
  /// `externalCouponId` is kept.
  providerReference String?

  /// JSON object of custom field key/values. Max 50 keys, enforced in app code.
  customFields String @default("{}")

  /// Provider-specific facts with no column of their own, as JSON. Serialized
  /// via src/core/repositories/json-column.ts.
  providerMetadata String @default("{}")

  updatedAt DateTime @updatedAt

  @@unique([integrationId, externalSourceId])
  @@index([integrationId])
  @@index([invoiceId])
  @@index([customerId])
  /// "What came in this month" is the first query this table exists to answer.
  @@index([integrationId, processedAt])
}

// ---------------------------------------------------------------------------
// Identity resolution
//
// One real company connected through HubSpot, Stripe and Metrifox arrives as
// three unrelated `Customer` rows — every write and lookup above is scoped by
// `integrationId`, and `Customer` is keyed `[integrationId, externalSourceId]`.
// These four tables are what makes those three rows one company.
//
// `userId` on every one of them is the load-bearing detail. Two users can hold
// customers with the same billing address, and an account or key that is not
// tenant-scoped would merge them. That is the severe failure mode here: not a
// missed join, which is visible and recoverable, but one customer's data
// appearing under another's company. Every query in
// src/core/repositories/identity-repository.ts filters on it, and the uniques
// below lead with it.
// ---------------------------------------------------------------------------

/// One real-world company. Many per-integration `Customer` rows resolve onto it.
model CustomerAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Survivorship result, mirroring CUSTOMER_SCHEMA: each field won by the
  /// highest-priority member that actually supplies a value — a null is not an
  /// opinion, so a top-ranked source carrying no industry does not blank it.
  ///
  /// Materialized rather than computed on read, so accounts sort and filter in
  /// SQL the way `Customer` already does. Safe to materialize because it is a
  /// pure function of (members, precedence) and every pass recomputes it whole,
  /// so it cannot drift from its inputs.
  name       String
  domain     String?
  email      String?
  industry   String?
  createDate DateTime?

  /// CustomerType: prospect | customer | partner | vendor
  type String?

  /// Union across members, higher priority winning a shared key. JSON via
  /// src/core/repositories/json-column.ts, bounded by MAX_CUSTOM_FIELDS.
  customFields String @default("{}")

  /// field path -> source evidence, as JSON.
  ///
  /// Each entry names the winning integration, source `Customer` id, provider
  /// record id, evidence key/value and observation time, and keeps every losing
  /// value with the reason it lost. Custom fields use the key
  /// `customFields.<name>`, so a shared custom key has the same reviewable
  /// provenance as a built-in field.
  ///
  /// Traceability is an explicit requirement of the governing spec, and it is
  /// what lets the UI show a source chip beside each field instead of
  /// presenting a merged record as if it came from nowhere. The reader accepts
  /// the previous string-valued shape, so accounts resolved before this JSON
  /// grew stay readable until their next pass.
  fieldProvenance String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Customer[]
  keys    CustomerAccountKey[]

  @@index([userId])
  @@index([userId, name])
}

/// The identity table: `customer_account_id -> [keys]`, one-to-many.
///
/// `@@unique([userId, kind, value])` *is* the join. Within one tenant a key
/// belongs to at most one account, so a second account claiming the same key is
/// a detectable conflict rather than a silent overwrite — and the database, not
/// the resolver, is what guarantees it under concurrent passes.
///
/// `userId` is denormalized rather than reached through the account because
/// Prisma cannot express a unique spanning a relation. `OAuthState` keeps
/// `subjectKind`/`subjectId` flat for the same reason.
model CustomerAccountKey {
  id     String @id @default(uuid())
  userId String

  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  /// IdentityKeyKind: external_ref | email | domain.
  ///
  /// The array order in src/core/types/common.ts is the strength ranking, which
  /// is why it is an ordered const and not a Set: when two accounts both match,
  /// the stronger kind wins. A foreign system's own id beats an email beats a
  /// shared domain.
  kind String

  /// The normalized matching value — lowercased, trimmed, plus-tag stripped for
  /// emails; a bare host for domains; `<provider>:<scope>:<externalId>` for
  /// external_ref. Never displayed: show `rawValue`.
  value String

  /// As the provider gave it, first writer wins. Kept so a user adjudicating a
  /// conflict sees the address they recognise rather than its normalized form.
  rawValue String

  /// EmailClass: corporate | role | freemail.
  ///
  /// Always "corporate" for a domain key, because a freemail host is refused as
  /// a domain key outright — that refusal is the whole defence against someone
  /// mapping an email through `domainFromUrl` and merging every
  /// consumer-address customer into one account.
  emailClass String

  /// IdentityEvidenceSource: customer_email | customer_domain |
  /// customer_custom_field | contact_email | self_reference | mapped_cross_ref |
  /// imported_crosswalk
  source              String
  sourceIntegrationId String

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@unique([userId, kind, value])
  @@index([customerAccountId])
}

/// A human's verdict on whether two customers are the same company. Outranks
/// every inferred key.
///
/// Anchored to `Customer` rows, **not** accounts. Account ids are created,
/// absorbed and reaped by every pass, so they are not stable anchors — an
/// assertion pinned to one would evaporate the first time its account was
/// absorbed. A `Customer` row survives re-sync, because the writer upserts it,
/// and cascades away with its integration. That is exactly the lifetime an
/// assertion should have.
///
/// `distinct` matters as much as `same`. A false merge is any matcher's worst
/// failure, and without a negative verdict a shared role address on a shared
/// agency domain would re-merge on every pass with nothing the user could do
/// about it. Assertions are only ever read by the resolver, never written by
/// it, which is what makes them stick through a pass that recomputes
/// everything else.
model IdentityAssertion {
  id String @id @default(uuid())

  /// Denormalized for filtering. No `User` relation: these cascade away
  /// through `Customer` -> `Integration` -> `User`, so a second cascade path
  /// would add nothing but a way for the two to disagree.
  userId String

  /// IdentityAssertionKind: same | distinct
  kind String

  /// Canonically ordered, so `leftCustomerId` < `rightCustomerId`
  /// lexicographically. Without that ordering (A,B) and (B,A) both insert
  /// happily and the unique below means nothing.
  leftCustomerId  String
  rightCustomerId String
  left            Customer @relation("AssertionLeft", fields: [leftCustomerId], references: [id], onDelete: Cascade)
  right           Customer @relation("AssertionRight", fields: [rightCustomerId], references: [id], onDelete: Cascade)

  /// Why, in the user's own words. Shown when explaining a grouping.
  note String?

  createdAt DateTime @default(now())

  @@unique([leftCustomerId, rightCustomerId])
  @@index([userId])
}

/// One execution of the resolution pass.
///
/// Per user, not per integration — resolution is cross-integration by nature,
/// which is also why it is a separate pass rather than a step inside
/// `sync-engine`. Modelled on `SyncRun` below down to the JSON-in-String issues
/// column: same lifecycle, and the same policy that a per-record problem is
/// recorded and never aborts the run. It reuses SyncRunStatus because the states
/// it uses mean the same things here, "discarded" included — that is what the
/// concurrency guard produces. "Abandoned" belongs to durable sync ownership
/// and is not produced by this pass.
model IdentityResolutionRun {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SyncRunStatus: running | success | partial | failed | discarded
  status String

  /// IdentityRunTrigger: sync | scheduled | manual
  trigger String @default("sync")

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  accountsCreated  Int @default(0)
  accountsAbsorbed Int @default(0)
  accountsReaped   Int @default(0)
  customersLinked  Int @default(0)
  keysIndexed      Int @default(0)

  /// JSON array of IdentityIssue, via src/core/repositories/json-column.ts.
  issuesJson String @default("[]")

  /// `startedAt` is indexed because it is both how runs are listed and the
  /// watermark the incremental path will filter `Customer.updatedAt` against.
  @@index([userId, startedAt])
}

model SyncRun {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// SyncRunStatus: running | success | partial | failed | discarded | abandoned
  status String

  trigger String @default("manual")

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// Durable ownership for a run that can outlive one request.
  ///
  /// The in-process Set in sync-engine.ts is a fast path, not the authority:
  /// behind two instances it cannot see the other worker. Claiming a run is a
  /// transaction that takes a per-integration advisory lock, checks for a live
  /// lease, marks any expired `running` run abandoned, and creates this run with
  /// a monotonically increasing fencing token. A stale worker's later update
  /// must match owner + token + run and re-check expiry, so a paused worker
  /// cannot close a run another worker has taken over.
  leaseOwner     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  fencingToken   Int       @default(0)

  /// Rows written per target object this run, as JSON:
  /// `{"customer": 12, "contact": 30}`. Read and written through
  /// src/core/repositories/json-column.ts.
  ///
  /// A map rather than the `customerCount`/`contactCount` pair it replaces.
  /// Those two were fine while identity was the only function with a handler,
  /// but every new object would have meant another column, another migration
  /// and another branch in the run report — and a run that wrote no customers
  /// would still have had to claim a customer count of zero. An absent key says
  /// "this run did not write that object", which is the honest answer for a
  /// catalog sync.
  recordCountsJson String @default("{}")

  /// What the run actually acquired, per function and target object:
  /// pages fetched, records read/written, whether the handler declared the
  /// list whole, which mapped objects were never yielded, and which supported
  /// objects had no mapping. A successful write is not the same claim as
  /// complete coverage; this column is where the difference is stored.
  ///
  /// Read and written through src/core/sync/coverage.ts and
  /// src/core/repositories/sync-run-repository.ts. Defaults to `{}` so runs
  /// recorded before this column existed read as "coverage not recorded"
  /// rather than as complete.
  coverageJson String @default("{}")

  attempt Int @default(1)

  /// JSON array of { sourceRecordId, targetObject, reason, fieldName? }.
  errorsJson String @default("[]")

  @@index([integrationId, startedAt])
  @@index([status, leaseExpiresAt])
}

/// A provider and function set the user has configured but not yet connected.
///
/// Nothing is written to `Integration` until a credential has been proven, so
/// this row is where a half-finished connect lives. It is not user data: it has
/// a TTL, it is consumed on success, and losing one costs the user a re-pick.
///
/// It is a table rather than a Map on `globalThis` because the three steps that
/// touch a draft — create, render the connect page, submit the credential — are
/// separate requests, and on a multi-instance host they land on different
/// instances. In-process, the second step cannot see what the first wrote.
model IntegrationDraft {
  /// Unguessable rather than sequential: this id is the handle used to attach a
  /// credential, so it must not be enumerable. Generated in the store, not by
  /// `@default(uuid())`.
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Registered provider name, e.g. "hubspot" | "stripe" | "mock".
  providerName String

  /// JSON array of registered function names, read and written through
  /// src/core/repositories/json-column.ts.
  functionNames String

  /// User-facing label the integration will be created with.
  instanceLabel String

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// An issued OAuth `state` value, awaiting its callback.
///
/// CSRF defence for the authorization flow: a callback that does not return a
/// value recorded here is refused. Single-use, which is why the row is deleted
/// as it is read — the delete is the check, and only one caller can win it.
///
/// A table for the same reason as `IntegrationDraft`: `/start` issues the state
/// and `/callback` consumes it, and those are separate requests that need not
/// reach the same instance.
model OAuthState {
  /// The state value itself, and the primary key: lookup is by exact match, and
  /// a duplicate would mean `generateState` had collided.
  state String @id

  /// StateSubject discriminant: "draft" | "integration". Kept as two columns
  /// rather than a relation because `subjectId` names a row in one of two
  /// different tables depending on this value.
  subjectKind String
  subjectId   String

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([subjectKind, subjectId])
  @@index([expiresAt])
}
