{
  "name": "integration-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Integration Platform — function-scoped OAuth integrations with a field mapping layer",
  "scripts": {
    "dev": "next dev",
    "dev:stop": "tsx scripts/dev-stop.mts",
    "dev:restart": "npm run dev:stop && npm run dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property",
    "test:integration": "vitest run tests/integration",
    "db:push": "prisma db push",
    "db:pg": "tsx scripts/pg-schema.mts",
    "db:pg:push": "npm run db:pg && prisma db push --schema prisma/schema.postgres.prisma",
    "build:deploy": "npm run db:pg && prisma generate --schema prisma/schema.postgres.prisma && next build",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "users:add": "tsx scripts/add-users.mts",
    "worker": "tsx scripts/worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.1.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "fast-check": "^3.23.2",
    "msw": "^2.7.0",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
